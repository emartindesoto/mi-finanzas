{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist/assets",
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
